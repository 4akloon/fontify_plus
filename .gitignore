# See https://dart.dev/guides/libraries/private-files
.vscode/
.idea/

# Files and directories created by pub
.dart_tool/
.packages
build/

# Root lockfile only — the Flutter example may keep its own.
/pubspec.lock

# Directory created by dartdoc
doc/api/

# Internal design specs / plans (not the published doc/ guides)
docs/

# Python bytecode from tool/ oracle and proto scripts
__pycache__/
*.pyc

# Avoid committing generated JavaScript files
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map
